<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="14sp" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_status_stopped" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/widget_refresh" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_weight="1" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_upload_label" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_total_upload" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:includeFontPadding="false" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_total_upload" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_zero_bytes" android:textSize="22sp" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="2" android:includeFontPadding="false" android:gravity="center_vertical" />
            <TextView android:id="@+id/widget_upload" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_zero_upload_speed" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:includeFontPadding="false" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_download_label" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_total_download" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:includeFontPadding="false" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_total_download" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_zero_bytes" android:textSize="22sp" android:textColor="@color/widget_text_primary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="2" android:includeFontPadding="false" android:gravity="center_vertical" />
            <TextView android:id="@+id/widget_download" android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/widget_zero_download_speed" android:textSize="11sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:includeFontPadding="false" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/widget_rule" android:layout_width="0dp" android:layout_height="42dp" android:text="@string/widget_rule" android:textSize="12sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:paddingHorizontal="1dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_global" android:layout_width="0dp" android:layout_height="42dp" android:text="@string/widget_global" android:textSize="12sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:paddingHorizontal="1dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_direct" android:layout_width="0dp" android:layout_height="42dp" android:text="@string/widget_direct" android:textSize="12sp" android:textColor="@color/widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center" android:paddingHorizontal="1dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_toggle" android:layout_width="56dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/widget_selected_light" android:src="@drawable/widget_power" android:contentDescription="@string/widget_start" />
    </LinearLayout>
</LinearLayout>