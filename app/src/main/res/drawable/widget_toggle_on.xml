<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <solid android:color="@color/widget_switch_track_on" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical|right" android:right="2dp">
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <solid android:color="@color/widget_switch_thumb" />
            <stroke android:width="1dp" android:color="@color/widget_switch_thumb_stroke" />
        </shape>
    </item>
</layer-list>
